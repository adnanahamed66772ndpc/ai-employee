# Copy to .env.local and fill in yourself. .env.local is git-ignored.

# Model gateway used by every agent (https://platform.cheaperinference.com). Only the server holds it;
# agents reach models through the server at http://127.0.0.1:<port>/llm/v1.
CHEAPERINFERENCE_API_KEY=

# Optional: dashboard/server port (default 7717) and where brain.db lives (default ./data)
# AI_EMPLOYEE_PORT=7717
# AI_EMPLOYEE_DATA_DIR=

# Server/VPS: run agents and project checks as an unprivileged Linux user
# (create it once with: sudo bash scripts/vps/setup-agent-user.sh)
# AI_EMPLOYEE_AGENT_USER=aiagent
# Where projects live (default /srv/ai-projects with an agent user, else ~/ai-projects)
# AI_EMPLOYEE_PROJECTS_DIR=

# How many tasks may run at the same time, each in its own git worktree (default 1, at most 8)
# AI_EMPLOYEE_MAX_TASKS=1

# Public dashboard URL behind nginx. Requires a password: npm run set-password
# AI_EMPLOYEE_PUBLIC_URL=https://ai.example.com

# Telegram notifications: create a bot with @BotFather, send it a message, then run npm run telegram:chat-id
# AI_EMPLOYEE_TELEGRAM_BOT_TOKEN=
# AI_EMPLOYEE_TELEGRAM_CHAT_ID=
